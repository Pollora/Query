{
    "name": "pollora/query",
    "description": "Create WP Query in a fluent way.",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Gorzalka",
            "email": "olivier@amphibee.fr",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pollora\\Query\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "pollora/wordpress-args": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^3.8",
        "pollora/harness": "^0.1.11"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    }
}
